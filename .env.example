# Copy to .env and change what you need. Every line shows its default.

# Where the helper listens. Handy's Custom provider points at http://HOST:PORT/v1
HC_HOST=127.0.0.1
HC_PORT=8765

# The cleanup model. Any OpenAI-compatible endpoint works.
# Default is Ollama on this laptop: screen text never leaves the machine.
# PRIVACY: a cloud URL here sends your screen text and dictation to that provider.
HC_UPSTREAM_BASE_URL=http://127.0.0.1:11434/v1
HC_UPSTREAM_API_KEY=
# The instruct build: plain qwen3:4b (2507) always thinks first and runs 10x longer.
HC_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Sent as reasoning_effort: "none" turns qwen3's thinking off; gpt-oss takes low/medium/high.
HC_REASONING_EFFORT=none
# Groq's free plan (the Framework, 2026-10-08; turn on Zero Data Retention in its console):
# HC_UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
# HC_UPSTREAM_API_KEY=gsk_...
# HC_MODEL=openai/gpt-oss-120b
# HC_REASONING_EFFORT=low
# With a cloud model above, a 429 (rate limit), a 5xx or no connection hands the
# dictation to this local model; after a 429 the cloud rests for Retry-After seconds.
# The fallback is off when the main model is already this one.
HC_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
HC_FALLBACK_MODEL=qwen3:4b-instruct-2507-q4_K_M
HC_FALLBACK_TIMEOUT_S=8

# Your dictionary. Default: %APPDATA%\handy-context\dictionary.txt
# HC_DICTIONARY=

# Seconds to wait for the model before pasting the raw transcript instead.
HC_TIMEOUT_S=4
# Milliseconds allowed for reading the screen, and how much of it the model sees:
# text around the cursor, and other text in the window. More text means a slower
# model (measured: ~430 ms with none, ~970 ms at 2000 + 2000). Selections stay whole.
HC_CONTEXT_BUDGET_MS=250
HC_CONTEXT_MAX_CHARS=1000
HC_VISIBLE_MAX_CHARS=500

# Logs. Default: %APPDATA%\handy-context\logs. Screen text is logged only if 1.
# HC_LOG_DIR=
HC_LOG_CONTEXT=0

# Edit by voice. With text selected, what you say changes the selection (always on).
# With nothing selected, an order like "add please at the end" changes your last
# dictation if it is still right before the cursor and under HC_EDIT_WINDOW_S old.
HC_EDIT_LAST=1
HC_EDIT_WINDOW_S=60
# Learn from your hand fixes: a word you correct twice the same way goes into dictionary.txt.
HC_LEARN=1
# How long Ollama keeps the model loaded after a request; "-1m" = always (holds 3.2 GB of GPU memory;
# a reload takes ~3.6 s, close to the 4 s budget). Needs a unit: a bare -1 is rejected.
HC_KEEP_ALIVE=-1m

# Windows: the Aqua-style floater, and Right Alt shortcuts (hold to talk,
# Right Alt+Space for hands-free). Handy listens on F13; the helper presses it.
HC_FLOATER=1
HC_RIGHT_ALT=1
# Default: %LOCALAPPDATA%\Handy\handy.exe (used only to cancel a recording)
# HC_HANDY_EXE=
